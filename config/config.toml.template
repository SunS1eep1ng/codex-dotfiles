# Personal Codex defaults shared across machines.
# Machine-generated runtime paths, auth, cache, sessions, logs, and secrets are intentionally excluded.

model = "gpt-5.6-sol"
model_provider = "openai_https"
model_reasoning_effort = "xhigh"
personality = "pragmatic"
service_tier = "default"

[model_providers.openai_https]
name = "OpenAI HTTPS only"
wire_api = "responses"
requires_openai_auth = true
supports_websockets = false

[desktop]
conversationDetailMode = "STEPS_COMMANDS"
ambient-suggestions-enabled = false
appearanceTheme = "dark"
keepRemoteControlAwakeWhilePluggedIn = false
followUpQueueMode = "queue"

[windows]
sandbox = "unelevated"

[features]
js_repl = false
memories = true

[plugins."browser@openai-bundled"]
enabled = true

[plugins."build-web-apps@openai-curated"]
enabled = true

[plugins."chrome@openai-bundled"]
enabled = true

[plugins."computer-use@openai-bundled"]
enabled = true

[plugins."documents@openai-primary-runtime"]
enabled = true

[plugins."figma@openai-curated"]
enabled = true

[plugins."github@openai-curated"]
enabled = true

[plugins."latex@openai-bundled"]
enabled = true

[plugins."linear@openai-curated"]
enabled = true

[plugins."pdf@openai-primary-runtime"]
enabled = true

[plugins."presentations@openai-primary-runtime"]
enabled = true

[plugins."sites@openai-bundled"]
enabled = true

[plugins."spreadsheets@openai-primary-runtime"]
enabled = true

[plugins."template-creator@openai-primary-runtime"]
enabled = true

[plugins."visualize@openai-bundled"]
enabled = true

# Optional local MCP example. Keep keys out of Git.
# Uncomment and fill locally after sync if needed.
#
# [mcp_servers.example]
# url = "http://127.0.0.1:3501/mcp"
# http_headers = { "x-mcp-key" = "PUT_LOCAL_KEY_HERE" }
# startup_timeout_sec = 20
# tool_timeout_sec = 60
# enabled = true
# default_tools_approval_mode = "prompt"
